{
  "name": "reel-irie-charters-llc",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  // Lets the worker import schema.sql as text (it creates the tables on first use)
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // Add the custom domain once it's connected to this Cloudflare account:
  // "routes": [
  //   { "pattern": "reeliriecharters.com", "custom_domain": true },
  //   { "pattern": "www.reeliriecharters.com", "custom_domain": true }
  // ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The worker sees every request first (pre-launch passcode, captain's login).
    // At launch, once SITE_PASSCODE is deleted, this can go back to ["/admin", "/admin/*", "/api/*"]
    "run_worker_first": true
  },

  // Bookings and calendar. Create once with: npx wrangler d1 create reel-irie
  // then paste the database_id it prints here and run: npm run db:remote
  "d1_databases": [
    { "binding": "DB", "database_name": "reel-irie", "database_id": "205dd00b-f57f-401e-afa2-52f5176fc0e7" }
  ],

  "vars": {
    // Who can open /admin (comma separated). Must match the Cloudflare Access policy.
    "ADMIN_EMAILS": "reeliriecharters@gmail.com,forrestisbrown@icloud.com",
    // From Zero Trust > Settings (team domain) and the Access application's AUD tag
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Booking emails go here until Email Routing (below) is set up
    // Server side FormSubmit gets rate limited on Cloudflare, so the browser sends booking emails.
    "FORMSUBMIT_EMAIL": ""
    // Once Email Routing is on for the domain, add:
    // "NOTIFY_FROM": "bookings@reeliriecharters.com",
    // "NOTIFY_TO": "<captain's verified email>"
  }

  // Branded booking emails through Cloudflare Email Routing (after the domain is connected):
  // "send_email": [{ "name": "NOTIFY" }]
}
